{
  "extends": "flarum-tsconfig",
  "include": ["src/**/*", "forum.js", "admin.js", "../vendor/*/*/js/dist-typings/@types/**/*"],
  "compilerOptions": {
    // TypeScript 7 removed flarum-tsconfig's `moduleResolution: "Node"`.
    "module": "esnext",
    "moduleResolution": "bundler",
    "paths": {
      "flarum/*": ["../vendor/flarum/core/js/dist-typings/*"]
    }
  }
}
